{
  "name": "env",
  "description": "Run a program in a modified environment",
  "options": [
    {
      "name": [
        "-i",
        "--ignore-environment"
      ],
      "description": "Start with an empty environment"
    },
    {
      "name": [
        "-u",
        "--unset"
      ],
      "description": "Remove a variable",
      "args": {
        "name": "name"
      }
    }
  ],
  "args": {
    "name": "command",
    "isCommand": true
  }
}
