            "networkpolicies",
            "roles",
            "rolebindings",
            "clusterroles",
            "clusterrolebindings",
            "storageclasses",
            "customresourcedefinitions",
            "all"
          ]
        },
        {
          "name": "name",
          "isOptional": true,
          "isVariadic": true,
          "generators": [
            {
              "builtin": "kube:names:"
            }
          ]
        }
      ]
    },
    {
      "name": "api-resources",
      "description": "Print supported API resources"
    },
    {
      "name": "cluster-info",
      "description": "Display cluster information"
    },
    {
      "name": "version",
      "description": "Print version information"
    },
    {
      "name": "explain",
      "description": "Documentation of resources",
      "args": {
        "name": "type",
        "suggestions": [
          "pods",
          "deployments",
          "services",
          "nodes",
          "namespaces",
          "configmaps",
          "secrets",
          "ingresses",
          "statefulsets",
          "daemonsets",
          "replicasets",
          "jobs",
          "cronjobs",
          "persistentvolumeclaims",
          "persistentvolumes",
          "serviceaccounts",
          "events",
          "endpoints",
          "horizontalpodautoscalers",
          "networkpolicies",
          "roles",
          "rolebindings",
          "clusterroles",
          "clusterrolebindings",
          "storageclasses",
          "customresourcedefinitions",
          "all"
        ]
      }
    }
  ]
