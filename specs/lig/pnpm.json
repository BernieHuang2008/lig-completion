{
  "name": "pnpm",
  "description": "Node package manager",
  "options": [
    {
      "name": [
        "-v",
        "--version"
      ],
      "description": "Print version"
    },
    {
      "name": [
        "-C",
        "--dir",
        "--cwd"
      ],
      "description": "Run in this directory",
      "args": {
        "name": "dir",
        "template": "folders"
      },
      "isPersistent": true
    }
  ],
  "subcommands": [
    {
      "name": "add",
      "description": "Add packages",
      "options": [
        {
          "name": [
            "-D",
            "--dev"
          ],
          "description": "Add as a dev dependency"
        },
        {
          "name": [
            "-E",
            "--exact"
          ],
          "description": "Install exact versions"
        },
        {
          "name": [
            "-g",
            "--global"
          ],
          "description": "Install globally"
        },
        {
          "name": [
            "-O",
            "--optional"
          ],
          "description": "Add as optional dependency"
        }
      ],
      "args": {
        "name": "package",
        "isVariadic": true,
        "generators": [
          {
            "builtin": "online:npm"
          }
        ]
      }
    },
    {
      "name": [
        "install",
        "i"
      ],
      "description": "Install all dependencies (or add packages)",
      "options": [
        {
          "name": "--frozen-lockfile",
          "description": "Don't update the lockfile"
        },
        {
          "name": [
            "--prod",
            "--production"
          ],
          "description": "Only production dependencies"
        }
      ],
      "args": {
        "name": "package",
        "isOptional": true,
        "isVariadic": true,
        "generators": [
          {
            "builtin": "online:npm"
          }
        ]
      }
    },
    {
      "name": [
        "remove",
        "rm",
        "uninstall"
      ],
      "description": "Remove packages",
      "options": [
        {
          "name": [
            "-g",
            "--global"
          ],
          "description": "Remove globally"
        }
      ],
      "args": {
        "name": "package",
        "isVariadic": true,
        "generators": [
          {
            "builtin": "npm:deps"
          }
        ]
      }
    },
    {
      "name": [
        "update",
        "up",
        "upgrade"
      ],
      "description": "Update packages",
      "options": [
        {
          "name": [
            "-L",
            "--latest"
          ],
          "description": "Ignore version ranges"
        },
        {
          "name": [
            "-i",
            "--interactive"
          ],
          "description": "Interactive"
        }
      ],
      "args": {
        "name": "package",
        "isOptional": true,
        "isVariadic": true,
        "generators": [
          {
            "builtin": "npm:deps"
          }
        ]
      }
    },
    {
      "name": "run",
      "description": "Run a package.json script",
      "args": [
        {
          "name": "script",
          "generators": [
            {
              "builtin": "npm:scripts"
            }
          ]
        },
        {
          "name": "args",
          "isOptional": true,
          "isVariadic": true
        }
      ]
    },
    {
      "name": "exec",
      "description": "Run a command in the project context",
      "args": {
        "name": "command",
        "isCommand": true
      }
    },
    {
      "name": [
        "dlx",
        "x"
      ],
      "description": "Run a package without installing it",
      "args": {
        "name": "package",
        "generators": [
          {
            "builtin": "online:npm"
          }
        ]
      }
    },
    {
      "name": "create",
      "description": "Create a project from a starter kit",
      "args": {
        "name": "template"
      }
    },
    {
      "name": "init",
      "description": "Create a package.json file"
    },
    {
      "name": [
        "test",
        "t"
      ],
      "description": "Run the test script"
    },
    {
      "name": "start",
      "description": "Run the start script"
    },
    {
      "name": "build",
      "description": "Run the build script"
    },
    {
      "name": "dev",
      "description": "Run the dev script"
    },
    {
      "name": "outdated",
      "description": "Check for outdated packages",
      "args": {
        "name": "package",
        "isOptional": true,
        "isVariadic": true,
        "generators": [
          {
            "builtin": "npm:deps"
          }
        ]
      }
    },
    {
      "name": "why",
      "description": "Show why a package is installed",
      "args": {
        "name": "package",
        "isVariadic": true,
        "generators": [
          {
            "builtin": "npm:deps"
          }
        ]
      }
    },
    {
      "name": [
        "list",
        "ls"
      ],
      "description": "List installed packages",
      "options": [
        {
          "name": "--depth",
          "description": "Depth",
          "args": {
            "name": "n"
          }
        }
      ]
    },
    {
      "name": "link",
      "description": "Link a local package",
      "args": {
        "name": "dir",
        "isOptional": true,
        "template": "folders"
      }
    },
    {
      "name": "publish",
      "description": "Publish a package",
      "args": {
        "name": "dir",
        "isOptional": true,
        "template": "folders"
      }
    },
    {
      "name": "audit",
      "description": "Check for known vulnerabilities"
    },
    {
      "name": "store",
      "description": "Manage the package store",
      "subcommands": [
        {
          "name": "prune",
          "description": "Remove unreferenced packages"
        },
        {
          "name": "path",
          "description": "Print the store path"
        },
        {
          "name": "status",
          "description": "Check for modified packages"
        }
      ]
    }
  ],
  "args": {
    "name": "script",
    "isOptional": true,
    "generators": [
      {
        "builtin": "npm:scripts"
      }
    ]
  }
}
