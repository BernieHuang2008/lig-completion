{
  "name": "ssh",
  "description": "OpenSSH remote login client",
  "options": [
    {
      "name": "-p",
      "description": "Port",
      "args": {
        "name": "port"
      }
    },
    {
      "name": "-i",
      "description": "Identity file",
      "args": {
        "name": "file",
        "template": "filepaths"
      }
    },
    {
      "name": "-l",
      "description": "Login name",
      "args": {
        "name": "user"
      }
    },
    {
      "name": "-L",
      "description": "Local port forwarding",
      "args": {
        "name": "[bind:]port:host:hostport"
      }
    },
    {
      "name": "-R",
      "description": "Remote port forwarding",
      "args": {
        "name": "[bind:]port:host:hostport"
      }
    },
    {
      "name": "-D",
      "description": "Dynamic SOCKS forwarding",
      "args": {
        "name": "port"
      }
    },
    {
      "name": "-J",
      "description": "Jump host",
      "args": {
        "name": "destination",
        "generators": [
          {
            "builtin": "ssh:hosts"
          }
        ]
      }
    },
    {
      "name": "-o",
      "description": "Configuration option",
      "args": {
        "name": "option",
        "suggestions": [
          "StrictHostKeyChecking=no",
          "UserKnownHostsFile=/dev/null",
          "ServerAliveInterval=60",
          "ForwardAgent=yes"
        ]
      }
    },
    {
      "name": "-F",
      "description": "Config file",
      "args": {
        "name": "file",
        "template": "filepaths"
      }
    },
    {
      "name": "-A",
      "description": "Forward the authentication agent"
    },
    {
      "name": "-X",
      "description": "Enable X11 forwarding"
    },
    {
      "name": "-N",
      "description": "Don't execute a remote command"
    },
    {
      "name": "-T",
      "description": "Disable pseudo-terminal allocation"
    },
    {
      "name": "-t",
      "description": "Force pseudo-terminal allocation"
    },
    {
      "name": "-C",
      "description": "Compress data"
    },
    {
      "name": "-v",
      "description": "Verbose",
      "isRepeatable": true
    },
    {
      "name": "-q",
      "description": "Quiet mode"
    },
    {
      "name": "-4",
      "description": "IPv4 only"
    },
    {
      "name": "-6",
      "description": "IPv6 only"
    }
  ],
  "args": [
    {
      "name": "destination",
      "generators": [
        {
          "builtin": "ssh:hosts"
        }
      ]
    },
    {
      "name": "command",
      "isOptional": true,
      "isVariadic": true
    }
  ]
}
