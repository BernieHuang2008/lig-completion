{
  "name": "timeout",
  "description": "Run a command with a time limit",
  "options": [
    {
      "name": [
        "-s",
        "--signal"
      ],
      "description": "Signal",
      "args": {
        "name": "signal",
        "suggestions": [
          {
            "name": "HUP",
            "description": "Hangup / reload"
          },
          {
            "name": "INT",
            "description": "Interrupt (Ctrl-C)"
          },
          {
            "name": "QUIT",
            "description": "Quit and dump core"
          },
          {
            "name": "KILL",
            "description": "Kill, cannot be caught"
          },
          {
            "name": "TERM",
            "description": "Terminate gracefully (default)"
          },
          {
            "name": "STOP",
            "description": "Stop, cannot be caught"
          },
          {
            "name": "CONT",
            "description": "Continue if stopped"
          },
          {
            "name": "TSTP",
            "description": "Stop from terminal (Ctrl-Z)"
          },
          {
            "name": "USR1",
            "description": "User-defined signal 1"
          },
          {
            "name": "USR2",
            "description": "User-defined signal 2"
          },
          {
            "name": "ALRM",
            "description": "Alarm clock"
          },
          {
            "name": "CHLD",
            "description": "Child status changed"
          },
          {
            "name": "WINCH",
            "description": "Window size changed"
          },
          {
            "name": "PIPE",
            "description": "Broken pipe"
          }
        ]
      }
    },
    {
      "name": [
        "-k",
        "--kill-after"
      ],
      "description": "Kill after",
      "args": {
        "name": "duration"
      }
    }
  ],
  "args": [
    {
      "name": "duration",
      "suggestions": [
        "10s",
        "1m",
        "5m"
      ]
    },
    {
      "name": "command",
      "isCommand": true
    }
  ]
}
